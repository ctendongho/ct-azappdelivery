@model IEnumerable<CTInventoryPortal.Models.InventoryItem>

@{
    ViewData["Title"] = "Inventory";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>CT Inventory Portal</h1>

        <p class="text-muted">
            Manage inventory through SQL Server Always On Availability Group.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Add inventory item
    </a>
</div>

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<form method="get" class="row g-2 mb-4">
    <div class="col-md-6">
        <label for="search" class="form-label">
            Search inventory
        </label>

        <input
            id="search"
            type="text"
            name="search"
            value="@ViewBag.Search"
            class="form-control"
            placeholder="Search by product name or SKU" />
    </div>

    <div class="col-auto align-self-end">
        <button type="submit" class="btn btn-outline-primary">
            Search
        </button>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Clear
        </a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Product</th>
                <th>SKU</th>
                <th>Quantity</th>
                <th>Unit price</th>
                <th>Inventory value</th>
                <th>Created</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="7" class="text-center text-muted py-4">
                    No inventory items found.
                </td>
            </tr>
        }
        else
        {
            foreach (var item in Model)
            {
                var quantity = item.Quantity.GetValueOrDefault();
                var unitPrice = item.UnitPrice.GetValueOrDefault();
                var inventoryValue = quantity * unitPrice;

                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.Sku</td>
                    <td>@quantity</td>
                    <td>@unitPrice.ToString("C")</td>
                    <td>@inventoryValue.ToString("C")</td>
                    <td>@item.CreatedAtUtc.ToLocalTime().ToString("g")</td>

                    <td class="text-end">
                        <a
                            asp-action="Edit"
                            asp-route-id="@item.InventoryItemId"
                            class="btn btn-sm btn-outline-primary">
                            Edit
                        </a>

                        <form
                            asp-action="Delete"
                            asp-route-id="@item.InventoryItemId"
                            method="post"
                            class="d-inline"
                            onsubmit="return confirm('Delete this inventory item?');">

                            @Html.AntiForgeryToken()

                            <button
                                type="submit"
                                class="btn btn-sm btn-outline-danger">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>
